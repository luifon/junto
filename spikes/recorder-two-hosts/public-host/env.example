# /opt/junto-spike-link/.env on the public host (mode 600, not tracked)
WG_PORT=51820
WG_PUBLIC_END_ADDRESS=10.99.0.1
WG_DATA_END_ADDRESS=10.99.0.2
WG_DATA_END_PUBLIC_KEY=<public key printed by "genkey" on the data host>
# The Docker network of the existing media stack, where the name "redis" resolves.
MEDIA_NETWORK=junto-spike_default
