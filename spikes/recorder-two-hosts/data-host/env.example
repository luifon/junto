# /srv/junto-spike-rec/.env on the data host (mode 600, not tracked)
PUBLIC_HOST_ADDRESS=<address of the public host>
LIVEKIT_URL=ws://<address of the public host>:7880
LIVEKIT_API_KEY=<API key of the LiveKit server>
LIVEKIT_API_SECRET=<API secret of the LiveKit server>
REDIS_PASSWORD=<password of Redis on the public host>
WG_PORT=51820
WG_PUBLIC_END_ADDRESS=10.99.0.1
WG_DATA_END_ADDRESS=10.99.0.2
WG_PUBLIC_END_PUBLIC_KEY=<public key printed by "genkey" on the public host>
# Optional.
# EGRESS_LOG_LEVEL=info
# EGRESS_WORK_DIR=./egress-tmp        host directory mounted as Egress's working directory
# EGRESS_COMPOSITE_COST=3.0  EGRESS_TRACK_COST=0.1  EGRESS_TRACK_COMPOSITE_COST=0.5  EGRESS_MAX_CPU_UTILIZATION=0.8
# EGRESS_CPUS=6  CTL_CPUS=4
# EGRESS_ENTRYPOINT=/rescue-entrypoint.sh   copy a killed Egress's partial files to /out/rescued before it starts again
# EGRESS_RESTART=unless-stopped
