FROM docker.io/library/rust:1.98.1-slim-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      pkg-config \
      libfontconfig1-dev \
      libxcb1-dev \
      libxkbcommon-dev \
      libxkbcommon-x11-dev \
 && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/work/cargo CARGO_TARGET_DIR=/work/target
WORKDIR /work/src
