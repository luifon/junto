# Settings of a Junto deployment (docs/install.md). Copy this file to deploy/.env, which is
# not tracked, and keep that file readable for its owner only:
#
#   umask 077 && cp env.example .env && ./generate-secrets.sh >> .env
#
# Compose reads .env from this directory. A line is NAME=value without quotes and without
# spaces around "=". A setting that is commented out has the default that its comment states.
# The column "Forms" names the Compose files that read a setting: one (one-host.yaml),
# data (two-hosts-data.yaml), public (two-hosts-public.yaml), local (local.yaml).

# --- Secrets -------------------------------------------------------------------------
# No secret has a default, and Compose does not start without them. generate-secrets.sh
# prints the four lines with new random values. In the two-host form both hosts get the same
# values of the LiveKit key, the LiveKit secret and the Redis password. A secret consists of
# letters and digits only: the containers of PostgreSQL, Redis and the media server stop
# with a message when one has another character. Compose itself changes a value that has
# "$" or "#" before a container gets it.
#
# JUNTO_POSTGRES_PASSWORD     Password of the database role "junto_server", as which the
#                             server connects. Forms: one, data, local. PostgreSQL stores it
#                             at the first start; a later change of this line does not change
#                             the database, and the server then does not start
#                             (docs/install.md, "A changed secret").
# JUNTO_LIVEKIT_API_KEY       Name of the key of the media server. Forms: all.
# JUNTO_LIVEKIT_API_SECRET    Secret of that key, at least 32 characters. Forms: all.
# JUNTO_REDIS_PASSWORD        Password of Redis. Forms: all.

# --- Names and addresses -------------------------------------------------------------
# Optional for installation; both required by restore.sh. The prebuilt images of the
# release that wrote the backup. Use distinct tags for builds: server and init build in
# parallel. Without these settings, normal builds keep project-derived image names.
# Forms: one, data, local.
#JUNTO_SERVER_IMAGE=junto-server:release
#JUNTO_INIT_IMAGE=junto-init:release

# Three DNS names that point to the public address of the host (of the public host in the
# two-host form), each with an A record and, with IPv6, an AAAA record (ADR 0004).

# Name of the server. It is the address that people enter in the client. Forms: one, data, public.
JUNTO_SERVER_HOST=chat.example.test

# Name of the media server (LiveKit signalling). Forms: one, data, public.
JUNTO_LIVEKIT_HOST=livekit.example.test

# Name for TURN over TLS, the path for networks that allow only port 443. Forms: one, public.
JUNTO_TURN_HOST=turn.example.test

# Public IPv4 address of the host that runs the media server. The media server gives it to
# the clients as its media address, and the data host opens the private link to it.
# Forms: one, data, public.
JUNTO_PUBLIC_IP=192.0.2.10

# E-mail address that the certificate authority gets with the certificate requests (ACME).
# Forms: one, public.
JUNTO_ACME_EMAIL=admin@example.test

# --- Server --------------------------------------------------------------------------
# Name of the server and of its default workspace. Read at the first start only.
# Forms: one, data, local.
#JUNTO_SERVER_NAME=Junto

# Log records of the server: "json" or "text"; "error", "warn", "info", "debug" or "trace".
# Forms: one, data, local.
#JUNTO_LOG_FORMAT=json
#JUNTO_LOG_LEVEL=info

# Optional OpenTelemetry collector base URL. Unset or empty: no export. The server
# sends OTLP/HTTP JSON to <base>/v1/traces and <base>/v1/metrics every five seconds.
# The collector is operated separately and must be reachable from the server container.
# HTTP is for a private network; HTTPS verifies the collector with the system trust store.
# Only request method, route template, status and duration are exported (ADR 0007).
#JUNTO_OTEL_ENDPOINT=http://collector.example.test:4318

# Largest attachment in bytes (1 to 1073741824) and attachments per message (1 to 100).
# An administrator can change both later through the API. Forms: one, data, local.
#JUNTO_ATTACHMENT_BYTES=100000000
#JUNTO_ATTACHMENTS_PER_MESSAGE=10

# Before a migration of an upgrade the server copies its database to a second database
# "junto_before_<number>" on the same PostgreSQL server: "database". The copy needs free
# disk space of the size of the database, and a server whose copy fails does not start.
# "none" turns the copy off; then a backup is the only way back (docs/install.md, "Upgrade").
# Forms: one, data, local.
#JUNTO_MIGRATION_COPY=database

# --- Transcripts ---------------------------------------------------------------------
# Directory of the host with the model files of the transcription worker. Install them
# before the first transcript (docs/install.md, "One host", step 3). The worker's user
# (10001) must be able to read the directory and must not be able to write to it.
# Forms: one, data, local.
JUNTO_MODELS_DIR=/srv/junto/models

# The worker image: "cpu" or "gpu". "gpu" also needs worker-gpu.yaml (docs/install.md).
#JUNTO_WORKER_VARIANT=cpu

# Whisper model of the manifest, and the device: "auto", "cpu" or "cuda".
#JUNTO_TRANSCRIBE_WHISPER_MODEL=large-v3-turbo
#JUNTO_TRANSCRIBE_DEVICE=auto

# The number of speech clips that the speech model reads at one time, from 1 to 64. Without
# a line the worker uses the number of its model (8). A smaller number needs less memory: Whisper
# "small" on a CPU needed 2.1 GB with 8 and 1.1 GB with 1, at the same speed.
#JUNTO_TRANSCRIBE_BATCH_SIZE=8

# Limits of one transcription job. Without a line the worker uses its default, which
# workers/transcription/README.md states with the meaning of each limit.
#JUNTO_TRANSCRIBE_MAX_JOB_BYTES=4194304
#JUNTO_TRANSCRIBE_MAX_SEGMENTS=2000
#JUNTO_TRANSCRIBE_MAX_SEGMENT_SECONDS=21600
#JUNTO_TRANSCRIBE_MAX_JOB_SECONDS=86400
#JUNTO_TRANSCRIBE_MAX_PROCESSING_SECONDS=43200
#JUNTO_TRANSCRIBE_MAX_GAP_SECONDS=3600
#JUNTO_TRANSCRIBE_MAX_SPEAKER_WINDOWS=60000

# Whether the voices in shared sound get speaker labels: "true" or "false".
#JUNTO_TRANSCRIBE_SEPARATE_SPEAKERS=true

# The command that the server runs for a transcription job. The default hands the job to
# the worker container. An empty value turns transcripts off; then start Compose with
# "--scale worker=0".
#JUNTO_TRANSCRIBE_COMMAND=/usr/local/bin/junto-transcribe-handover

# Group of the GPU device nodes of the host, for worker-gpu.yaml: stat -c %g /dev/nvidiactl
#JUNTO_GPU_GROUP=10001

# --- Limits of the containers --------------------------------------------------------
# Memory (for example 512m, 2g) and CPUs (for example 0.5, 4) of each container. The
# defaults follow the measurements of docs/step-0/README.md and ADR 0610. One recording of
# 1080p used 2.5 to 3.9 cores and 1.6 GiB of the recorder; the server records two calls at a
# time. A transcription on a CPU needed 3.2 GB in one measurement whose machine and model are
# not recorded, and up to 4.1 GiB with the default model on Docker Desktop for macOS (arm64).
#
# Docker creates no container whose CPU limit is above the number of CPUs of its host. On a
# host with fewer CPUs than a default below, set that limit to the number of CPUs of the
# host: a public host of the two-host form with one CPU needs JUNTO_LIVEKIT_CPUS=1.
# check-limits.sh <form file> prints the line for each limit that the host refuses.
#JUNTO_POSTGRES_MEMORY=1g
#JUNTO_POSTGRES_CPUS=2
#JUNTO_SERVER_MEMORY=1g
#JUNTO_SERVER_CPUS=2
#JUNTO_REDIS_MEMORY=192m
#JUNTO_REDIS_CPUS=1
#JUNTO_LIVEKIT_MEMORY=2g
#JUNTO_LIVEKIT_CPUS=2
#JUNTO_RECORDER_MEMORY=4g
#JUNTO_RECORDER_CPUS=6
#JUNTO_WORKER_MEMORY=6g
#JUNTO_WORKER_CPUS=4
#JUNTO_ENTRY_MEMORY=256m
#JUNTO_ENTRY_CPUS=1
#JUNTO_LINK_MEMORY=256m
#JUNTO_LINK_CPUS=1

# Largest size of one log file of a container. Docker keeps five files per container.
#JUNTO_LOG_MAX_SIZE=10m

# --- Container network ---------------------------------------------------------------
# The network "backend" has fixed addresses, because the server names its entry by address
# and the media server uses the network of the host. Change the five values together, and
# only when the subnet is in use on the host. Forms: one, data, public.
#
# The server takes the address of a client from the forwarded header only for a request that
# comes from one address of this network: the gateway, from which the entry connects (one),
# or the link (data). The form file gives that address to the server as
# JUNTO_TRUSTED_PROXIES. The server would also accept a network there; the forms name the one
# address, because the recorder is a container of the same network.
#JUNTO_BACKEND_SUBNET=172.31.240.0/24
#JUNTO_BACKEND_GATEWAY=172.31.240.1
#JUNTO_BACKEND_SERVER=172.31.240.10
#JUNTO_BACKEND_REDIS=172.31.240.11
#JUNTO_BACKEND_LINK=172.31.240.12

# The network "inbound" of the public host in the two-host form, with the link as its only
# container. Change the three values together. Forms: public.
#JUNTO_INBOUND_SUBNET=172.31.242.0/24
#JUNTO_INBOUND_GATEWAY=172.31.242.1
#JUNTO_INBOUND_LINK=172.31.242.12

# --- Private link of the two-host form -----------------------------------------------
# Public key of the other host's link container. "docker compose -f <form> run --rm link
# genkey" creates the private key of a host in a volume and prints the public key. The
# private key never leaves its host. The command runs before these two lines are set; the
# link container does not start while its line is missing.
# On the public host: the key that the data host printed.
#JUNTO_LINK_DATA_PUBLIC_KEY=
# On the data host: the key that the public host printed.
#JUNTO_LINK_PUBLIC_PUBLIC_KEY=

# UDP port of the link on the public host, and the two addresses inside the link.
#JUNTO_LINK_PORT=51820
#JUNTO_LINK_PUBLIC_ADDRESS=10.99.0.1
#JUNTO_LINK_DATA_ADDRESS=10.99.0.2

# --- Local form only -----------------------------------------------------------------
# Loopback ports in local.yaml: the server, and the signalling, TCP media and UDP media ports
# of the media server.
#JUNTO_LOCAL_PORT=8080
#JUNTO_LOCAL_LIVEKIT_PORT=7880
#JUNTO_LOCAL_LIVEKIT_TCP_PORT=7881
#JUNTO_LOCAL_LIVEKIT_UDP_PORT=7882

# --- Test of the entry ---------------------------------------------------------------
# Leave this empty. "local_certs" makes the entry sign its certificates itself, for the test
# deploy/tests/entry.sh, which runs without public DNS names.
#JUNTO_ENTRY_CERTIFICATES=
